<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="#FAF6EC"
    android:contentDescription="Pounce morning alarm. Tap to open.">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_pounce"
            android:contentDescription="Pounce the cat" />
        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="POUNCE"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textSize="13sp"
            android:textColor="#B94F32" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="YOUR NEXT MORNING"
        android:textSize="10sp"
        android:letterSpacing="0.06"
        android:textStyle="bold"
        android:textColor="#596851"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A fresh start"
        android:textSize="27sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#211F22"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Tap to set your next alarm"
        android:textSize="12sp"
        android:textColor="#666A5E"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
